# Munlight Dashboard — environment variables
# Copy this file to `.env` and fill in the values for your environment.
# All client-exposed vars MUST be prefixed with VITE_ (Vite only exposes those).

# Base URL of the backend API, including the /api prefix.
# The app strips the trailing /api and re-adds it per request.
# Leave unset to default to http://localhost:8000/api.
VITE_API_URL=http://localhost:8000/api

# Public webhook URL shown on the Shipping and Settings pages
# (e.g. the Shiprocket webhook endpoint).
VITE_PUBLIC_WEBHOOK_URL=https://your-api-domain.com/api/webhooks/shiprocket

# Dev-only: target the Vite dev server proxies /api requests to.
# Used to sidestep the API's CORS allow-list during local development.
# Leave unset to default to https://munlightapi-preprod.up.railway.app
VITE_DEV_PROXY_TARGET=https://munlightapi-preprod.up.railway.app
